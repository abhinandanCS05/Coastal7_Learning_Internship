DATABASE_URL=sqlite:///./shopflow.db
JWT_SECRET=replace-with-a-strong-random-secret
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Day 20 AI assistant. Add keys only to backend/.env (never commit that file).
AI_PROVIDER_ORDER=groq,gemini,mistral
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
AI_CHAT_MAX_TOKENS=700
AI_CHAT_TEMPERATURE=0.2
AI_CHROMA_PATH=./data/chroma
