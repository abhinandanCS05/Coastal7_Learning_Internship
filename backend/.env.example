DATABASE_URL=sqlite:///./ecommerce.db

# Local Redis example:
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Upstash Redis example (use your own token; do not commit secrets):
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT:6379/0?ssl_cert_reqs=required
# CELERY_BROKER_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT:6379/0?ssl_cert_reqs=required
# CELERY_RESULT_BACKEND=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT:6379/0?ssl_cert_reqs=required

JWT_SECRET=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
