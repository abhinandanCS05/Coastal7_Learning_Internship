{
    "name": "shopflow-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:all": "npm run typecheck && npm run test && npm run test:e2e && npm run build",
        "test:e2e:headed": "playwright test --headed",
        "test:ci": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@tanstack/react-query": "^5.104.1",
        "axios": "^1.8.4",
        "lucide-react": "^0.468.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.89.0",
        "react-router-dom": "^7.1.5",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.1.13",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "jsdom": "^30.1.2",
        "msw": "^2.15.0",
        "tailwindcss": "^4.1.13",
        "typescript": "^7.0.2",
        "vite": "^7.3.6",
        "vitest": "^5.0.3"
    }
