    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:e2e":  "playwright test",
                    "test:all":  "npm run typecheck \u0026\u0026 npm run test \u0026\u0026 npm run test:e2e \u0026\u0026 npm run build",
                    "test:e2e:headed":  "playwright test --headed",
                    "test:ci":  "npm run typecheck \u0026\u0026 npm run test \u0026\u0026 npm run build \u0026\u0026 npm run test:e2e"
                },
